# ClientLoop Environment Configuration (.env.example)
# Copy to .env.local for local development. Never commit secret keys!

# ----------------------------------------------------
# 1. Supabase (PostgreSQL, Auth, Row Level Security)
# ----------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# Server-only (DO NOT expose in client code):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ----------------------------------------------------
# 2. WhatsApp Business Platform (Official Meta Cloud API)
# ----------------------------------------------------
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
# Server-only Meta access token:
WHATSAPP_ACCESS_TOKEN=EAAB...your-meta-system-user-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=clientloop_webhook_secret_verification_token

# ----------------------------------------------------
# 3. Application Settings & Pilot Defaults
# ----------------------------------------------------
APP_BASE_URL=http://localhost:5173
DEFAULT_COUNTRY_CODE=+1
PILOT_TIMEZONE=Africa/Lagos
COOLDOWN_HOURS=72

# ----------------------------------------------------
# 4. Optional Google Business Profile Review Sync
# ----------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
